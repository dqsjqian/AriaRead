# ──────────────────────────────────────────────
# AriaRead .gitignore
# ──────────────────────────────────────────────

# 构建目录
build/
.build/
.build_*/
out/
cmake-build-*/

# IDE
.vscode/*.log
.idea/
*.swp
*.swo
*~
.DS_Store

# 编译产物
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe

# 依赖（QuickJS 核心源文件已纳入版本管理）

# CMake 缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake.in

# CMake 生成的文件（version.h 等）
generated/

# 测试数据
tests/data/*.json

# 日志
*.log
*.diff

# 数据库文件（运行时生成）
*.db
*.db-shm
*.db-wal

# 临时文件
tmp/
temp/

# 个人书源数据与备份文件（不入库）
tests/rss*.json
*.bak

# 第三方 vendored 源码是上游交付物，不是本项目的构建产物。
# 上面的规则针对本项目自身的构建输出，但上游源码里合法存在同名文件
# （doctest 的 scripts/cmake/Config.cmake.in、zlib 的 Makefile 等），
# 会被静默忽略、漏提交，导致 CI 配置阶段才报错（本地因文件仍在磁盘上而无感）。
!third_party/**
build*/
